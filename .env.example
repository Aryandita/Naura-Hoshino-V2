# ==========================================
# 🤖 DISCORD CORE
# ==========================================
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PREFIX="n!"
OWNER_IDS=
GUILD_ID=
DISCORD_PUBLIC_KEY=

# ==========================================
# 🏷️ PARTNERSHIP & BRANDING
# ==========================================
# Catatan: BOT_VERSION & ENGINE_VERSION dipusatkan secara dinamis
# pada package.json (v2.4.0) sebagai Single Source of Truth (SSOT).
PARTNERSHIP="Belum ada kolaborasi"

# ==========================================
# 🌐 WEB DASHBOARD & PORTS
# ==========================================
DASHBOARD_PORT=3000
WEBHOOK_PORT=3071
DISCORD_CALLBACK_URL="http://localhost:3000/auth/discord/callback"
DASHBOARD_ORIGIN="http://localhost:3000"
SESSION_SECRET=

# ==========================================
# ⚡ SUPABASE (Primary Relational Cloud Provider)
# ==========================================
# Endpoint REST API Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"
# Supabase anon / publishable API key
SUPABASE_KEY="your-supabase-anon-or-publishable-key"
# Supabase project reference identifier
SUPABASE_PROJECT_ID="your-project-id"
# Supabase PostgreSQL connection string (Transaction pooler port 6543)
SUPABASE_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ==========================================
# 🍃 RELATIONAL DATABASE (PostgreSQL / Supabase Pooler)
# ==========================================
# Parameter database terurai (digunakan jika SUPABASE_DATABASE_URL tidak diset)
DB_DIALECT="postgres"
DB_HOST="aws-0-ap-southeast-1.pooler.supabase.com"
DB_PORT=6543
DB_USER="postgres.your-project-id"
DB_PASSWORD=
DB_NAME="postgres"
DB_SSL="true"
DB_POOL_BUDGET=80

# ==========================================
# 📦 NOSQL & CACHE (Polyglot Storage)
# ==========================================
MONGODB_URI=
REDIS_URL=

# ==========================================
# 🗄️ MYSQL (Optional Fallback / Legacy)
# ==========================================
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ==========================================
# 🎵 LAVALINK CLUSTER SETTINGS
# ==========================================
# Node 1 (Utama)
LAVALINK_NAME="Node 1"
LAVALINK_HOST="localhost"
LAVALINK_PORT="2333"
LAVALINK_PASSWORD="youshallnotpass"
LAVALINK_SECURE="false"

# Node 2 (Cadangan 1 - Opsional)
LAVALINK_NAME_2=
LAVALINK_HOST_2=
LAVALINK_PORT_2=
LAVALINK_PASSWORD_2=
LAVALINK_SECURE_2="false"

# Node 3 (Cadangan 2 - Opsional)
LAVALINK_NAME_3=
LAVALINK_HOST_3=
LAVALINK_PORT_3=
LAVALINK_PASSWORD_3=
LAVALINK_SECURE_3="false"

# Default search provider: ytmsearch / ytsearch / scsearch
MUSIC_DEFAULT_SEARCH="ytmsearch"

# ==========================================
# 🚀 SPOTIFY SETTINGS
# ==========================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET="ID"

# ==========================================
# 🔰 GOOGLE GEMINI & GROQ AI (AI Ensemble)
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
GROQ_API_KEY=
GROQ_MODEL="llama-3.3-70b-versatile"

# ==========================================
