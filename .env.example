# ==========================================
# 🔊 FISH AUDIO SETUP (TTS & AI DJ)
# ==========================================
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
AI_DJ_ENABLED="true"

# ==========================================
# 🧠 OLLAMA SETTINGS (Local AI Fallback)
