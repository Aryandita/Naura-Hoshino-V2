
# ==========================================
# 🤖 DISCORD BOT CREDENTIALS
# ==========================================
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"
CLIENT_ID="YOUR_DISCORD_CLIENT_ID_HERE"
PREFIX="n!"
OWNER_IDS="YOUR_OWNER_ID_HERE,ANOTHER_ID_HERE"

# ==========================================
# 🏷️ VERSION & PARTNERSHIP
# ==========================================
BOT_VERSION="1.2.0"
ENGINE_VERSION="1.1.0"
PARTNERSHIP="Partner Name or Community"

# ==========================================
# 🍃 DATABASE SETTINGS (MySQL / MariaDB)
# ==========================================
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_database_password_here"
MYSQL_DATABASE="naura_bot_db"

# ==============================
# 🌐 WEB DASHBOARD & OAUTH2
# ==============================
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID_HERE"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET_HERE"
DISCORD_CALLBACK_URL="http://localhost:3070/auth/discord/callback"
SESSION_SECRET="your_very_secret_session_key_here"

# ==========================================
# 🎵 LAVALINK SETTINGS (Untuk fitur musik)
# ==========================================
LAVALINK_HOST="127.0.0.1"
LAVALINK_PORT="2333"
LAVALINK_PASSWORD="youshallnotpass"
LAVALINK_SECURE="false"

# ==========================================
# 🌐 SERVER & PORTS
# ==========================================
DASHBOARD_PORT=3070
WEBHOOK_PORT=3071

# ==========================================
# 🔰 API KEYS
# ==========================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Dapatkan dari: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY="YOUR_OMDB_API_KEY_HERE"

# =========================================
# 🚀 SPOTIFY SETTINGS (Untuk mencari lagu di Spotify)
# =========================================
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID_HERE"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET_HERE"

# ==========================================
# 🤖 VERBA SETTINGS (Opsional)
# ==========================================
VERBA_API_KEY="YOUR_VERBA_API_KEY_HERE"
VERBA_SLUG_OWNER="slug-naura-owner"
VERBA_SLUG_PREMIUM="slug-naura-premium"
VERBA_SLUG_GENERAL="slug-naura-general"
VERBA_CHARACTER_SLUG="YOUR_VERBA_CHARACTER_SLUG_HERE" # Legacy / Fallback

# ==========================================
# 📦 REDIS CACHE
# ==========================================
REDIS_URL="redis://127.0.0.1:6379"

# Error Reporter Webhook (Opsional)
ERROR_WEBHOOK_URL=

# ==========================================
# 🧠 OLLAMA SETTINGS (Local AI — Opsional)
# ==========================================
# Unduh dari: https://github.com/ollama/ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# ==========================================
# 🎨 FOOOCUS SETTINGS (Local Image Generation — Opsional)
# ==========================================
# Unduh dari: https://github.com/lllyasviel/Fooocus
FOOOCUS_BASE_URL="http://localhost:7865"
