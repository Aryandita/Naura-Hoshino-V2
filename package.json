{
  "name": "naura-hoshino",
  "version": "2.1.0",
  "description": "Naura Hoshino, Bot Discord multifungsi dengan UI Canvas Modern",
  "main": "index.js",
  "scripts": {
    "prestart": "node scripts/migrate.js",
    "start": "node shard.js",
    "start:no-migrate": "node shard.js",
    "dev": "node --watch shard.js",
    "deploy": "node index.js --deploy",
    "db:migrate": "node scripts/migrate.js",
    "install-start": "npm install && npm start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "build:css": "tailwindcss -i ./dashboard/public/css/input.css -o ./dashboard/public/css/tailwind-compiled.css",
    "locales:check": "node scripts/validate-locales.js",
    "locales:check:strict": "node scripts/validate-locales.js --strict",
    "test:requires": "node scripts/check-requires.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "naura",
    "hoshino",
    "discord",
    "bot",
    "discord.js",
    "lavalink",
    "gemini-ai",
    "economy",
    "music",
    "canvas",
    "redis",
    "mysql"
  ],
  "author": "Aryandita",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@iamtraction/google-translate": "^2.0.1",
    "@napi-rs/canvas": "^0.1.53",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.69.0",
    "@tailwindcss/cli": "^4.3.3",
    "aki-api": "^7.0.1",
    "axios": "^1.6.8",
    "cors": "^2.8.6",
    "discord-html-transcripts": "^3.2.0",
    "discord.js": "^14.26.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^2.0.2",
    "googlethis": "^1.8.0",
    "helmet": "^8.3.0",
    "lyrics-finder": "^21.7.0",
    "mcstatus": "^1.0.1",
    "ms": "^2.1.3",
    "msedge-tts": "^1.1.0",
    "mysql2": "^3.9.7",
    "node_extra_ca_certs_mozilla_bundle": "^1.0.6",
    "node-cron": "^4.6.0",
    "ollama": "^0.5.15",
    "parse-duration": "^2.1.6",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "poru": "^5.3.0",
    "poru-spotify": "^2.0.2",
    "redis": "^4.7.1",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "spotify-url-info": "^3.3.2",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "prettier": "^3.8.3"
  }
}
