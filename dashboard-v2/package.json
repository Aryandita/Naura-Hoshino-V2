{
    "name": "naura-dashboard-v2",
    "version": "2.1.0",
    "description": "Dashboard Naura Hoshino V2 dengan 3D Model Viewer",
    "type": "module",
    "scripts": {
        "build:css": "tailwindcss -i src/css/input.css -o public/vendor/tailwind-built.css --minify",
        "watch:css": "tailwindcss -i src/css/input.css -o public/vendor/tailwind-built.css --watch",
        "dev": "npm run build:css && vite",
        "build": "npm run build:css && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.7.2",
        "chart.js": "^4.4.7",
        "three": "^0.177.0",
        "@pixiv/three-vrm": "^3.4.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "tailwindcss": "^4.3.3",
        "vite": "^6.3.5",
        "@vitejs/plugin-legacy": "^6.1.1"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "core-js@3.50.0": true
    }
}
